{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_CONVEX_URL",
        "CONVEX_HTTP_ACTIONS_URL",
        "NEXT_PUBLIC_SURVEY_FORM_URL",
        "ADMIN_USERNAME",
        "ADMIN_PASSWORD",
        "CONVEX_DEPLOYMENT"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "install": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
